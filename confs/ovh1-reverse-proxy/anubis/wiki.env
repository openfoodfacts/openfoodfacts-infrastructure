# /etc/anubis/wiki.env

# All environment variables are documented here: https://anubis.techaro.lol/docs/admin/installation/#environment-variables

# BIND adress policy: use the last number of the target container,
#                     here container 104
BIND=:8104

# Challenge level: higher = more difficult
DIFFICULTY=4

# Port and address for Prometheus. When Anubis is launched, 
# you can test it with: curl http://127.0.0.1:9090/metrics
METRICS_BIND=:9090

# The robots.txt file is the one from the target server
SERVE_ROBOTS_TXT=0

# The target IP
TARGET=http://10.1.0.104

# The file defining policy rules: https://anubis.techaro.lol/docs/admin/policies/
POLICY_FNAME=/etc/anubis/wiki.botPolicies.yaml

# Log level: DEBUG|INFO|WARN|ERROR (reverse order of verbosity)
# BE AWARE that DEBUG is very verbose.
#SLOG_LEVEL=INFO # Default
SLOG_LEVEL=WARN

# Avoid error in logs: {"time":"2025-11-19T09:25:42.050971542Z",
#                       "level":"WARN",
#                       "source":{
#                          "function":"main.main",
#                          "file":"/home/xe/code/TecharoHQ/anubis-release/cmd/anubis/main.go","line":424},
#                       "msg":"REDIRECT_DOMAINS is not set, Anubis will only redirect to the same domain a request 
#                              is coming from, see https://anubis.techaro.lol/docs/admin/configuration/redirect-domains"}
# see: https://anubis.techaro.lol/docs/admin/configuration/redirect-domains/
#REDIRECT_DOMAINS="*.openfoodfacts.org"