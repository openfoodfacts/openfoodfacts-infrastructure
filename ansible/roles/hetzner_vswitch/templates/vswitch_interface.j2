# This is generated by ansible
# Do not edit directly

{% for net_type, ip_addr in [("inet", hetzner_vswitch__ip_address), ("inet6", hetzner_vswitch__ip6_address)] %}
{% if ip_addr is defined %}
# Setup {{ net_type }} interface for vswitch of id {{ hetzner_vswitch__vlan_id }}
iface {{ hetzner_vswitch__interface }}.{{ hetzner_vswitch__vlan_id }} {{ net_type }} manual
    vlan-raw-device {{ hetzner_vswitch__interface }}
# Setup the {{ net_type }} corresponding bridge
auto {{ hetzner_vswitch__bridge_name }}
iface {{ hetzner_vswitch__bridge_name }} {{ net_type }} static
    address {{ ip_addr }}
    bridge-ports {{ hetzner_vswitch__interface }}.{{ hetzner_vswitch__vlan_id }}
    bridge-stp off
    bridge-fd 0
{% endif %}
{% endfor %}